# DataHub Cloud managed MCP endpoint or a self-hosted streamable HTTP endpoint.
DATAHUB_MCP_URL=https://<tenant>.acryl.io/integrations/ai/mcp/

# Use a service-account token for unattended workflows. Never expose this to the browser.
DATAHUB_MCP_TOKEN=

# Set to true only when the DataHub MCP server has mutation tools enabled.
DATAHUB_MCP_MUTATIONS=false

PORT=4174
